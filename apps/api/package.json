{
  "name": "@autotest/api",
  "version": "0.1.0",
  "private": true,
  "description": "平台 API + AI 规划 + 本地执行器",
  "scripts": {
    "dev": "nest start --watch --path tsconfig.dev.json",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:setup": "node prisma/prepare-sqlite.cjs && prisma db push && ts-node prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@autotest/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
